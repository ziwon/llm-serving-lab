# HuggingFace token for downloading gated models
HF_TOKEN=
# HF cache path on the host
HF_HOME=/data/LLM/models/hugging-face

# Optional pinned image tags for reproducible benchmarks
VLLM_IMAGE=vllm/vllm-openai:v0.21.0-cu129-ubuntu2404
VLLM_QUANTIZATION_ARGS=""
VLLM_EXTRA_ARGS=""
SGLANG_IMAGE=lmsysorg/sglang:nightly-dev-cu13-20260522-c9153da5
SGLANG_EXTRA_ARGS=""
TGI_IMAGE=ghcr.io/huggingface/text-generation-inference:3.3.5
TENSORRT_LLM_IMAGE=nvcr.io/nvidia/tensorrt-llm/release:1.2.0rc7
RAY_IMAGE=rayproject/ray:2.55.1-py312-gpu
PROMETHEUS_IMAGE=prom/prometheus:v3.11.0
DCGM_EXPORTER_IMAGE=nvidia/dcgm-exporter:4.4.1-4.6.0-distroless
GRAFANA_IMAGE=grafana/grafana:12.3.6-security-04-ubuntu
GRAFANA_ADMIN_PASSWORD=admin
RAY_BACKEND_URL=http://vllm:8000

# Optional OpenLIT / OpenTelemetry observability for benchmark client traces.
OPENLIT_ENABLED=false
OPENLIT_PORT=3001
OPENLIT_OTLP_ENDPOINT=http://127.0.0.1:4318
OPENLIT_APPLICATION_NAME=llm-serving-lab
OPENLIT_CAPTURE_MESSAGE_CONTENT=false
