# LLM Serving Lab — datacenter profile
# A100 40/80GB or H100 80GB, suitable for multi-GPU TP benchmarks

export LAB_PROFILE=datacenter

# --- GPU ---
export GPU_NAME="A100/H100"
export GPU_MEMORY_GB=80
export CUDA_VISIBLE_DEVICES=0,1,2,3
export TENSOR_PARALLEL_SIZE=4            # Sweep 1/2/4 in Phase 3

# --- Model ---
# Phase 1: 8B baseline, Phase 3: 32B/70B TP benchmark
export MODEL_ID="meta-llama/Llama-3.1-8B-Instruct"
export MODEL_QUANTIZATION="none"        # 80GB has enough FP16 headroom
export VLLM_QUANTIZATION_ARGS=""
export MAX_MODEL_LEN=32768
export GPU_MEMORY_UTILIZATION=0.92

# Phase 3 multi-GPU target models (overridden by scripts)
export MODEL_ID_32B="Qwen/Qwen3-32B"
export MODEL_ID_70B="meta-llama/Llama-3.3-70B-Instruct"

# --- Serving ---
export SERVED_PORT=8000
export MAX_NUM_SEQS=256
export MAX_INPUT_TOKENS=31744

# --- Images ---
export VLLM_IMAGE="vllm/vllm-openai:v0.21.0-cu129-ubuntu2404"
export SGLANG_IMAGE="lmsysorg/sglang:nightly-dev-cu13-20260522-c9153da5"
export TGI_IMAGE="ghcr.io/huggingface/text-generation-inference:3.3.5"
export TENSORRT_LLM_IMAGE="nvcr.io/nvidia/tensorrt-llm/release:1.2.0rc7"
export RAY_IMAGE="rayproject/ray:2.55.1-py312-gpu"
export PROMETHEUS_IMAGE="prom/prometheus:v3.11.0"
export DCGM_EXPORTER_IMAGE="nvidia/dcgm-exporter:4.4.1-4.6.0-distroless"
export GRAFANA_IMAGE="grafana/grafana:12.3.6-security-04-ubuntu"
export GRAFANA_ADMIN_PASSWORD="admin"
export RAY_BACKEND_URL="http://vllm:8000"

# --- Optional OpenLIT / OpenTelemetry ---
export OPENLIT_ENABLED=false
export OPENLIT_PORT=3001
export OPENLIT_OTLP_ENDPOINT="http://127.0.0.1:4318"
export OPENLIT_APPLICATION_NAME="llm-serving-lab"
export OPENLIT_CAPTURE_MESSAGE_CONTENT=false
export VLLM_OTEL_ARGS=""  # Enable with: --otlp-traces-endpoint grpc://host.docker.internal:4317
export VLLM_OTEL_SERVICE_NAME="vllm-server"
export VLLM_OTEL_PROTOCOL="grpc"
export VLLM_OTEL_INSECURE=true

# --- Benchmark ---
export BENCH_CONCURRENCY="1 8 16 32 64 128"
export BENCH_INPUT_TOKENS=1024
export BENCH_OUTPUT_TOKENS=512
export BENCH_NUM_PROMPTS=500

# --- Notes ---
# Phase 3: measure 70B scaling efficiency with TP=1/2/4.
# 70B is not viable on a single GPU -> start from TP>=2.
