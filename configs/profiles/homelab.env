# LLM Serving Lab — homelab profile
# RTX 5080 16GB (Blackwell, sm_120)
# Single GPU with tight KV cache budget -> 8B-class models plus quantization recommended

export LAB_PROFILE=homelab

# --- GPU ---
export GPU_NAME="RTX 5080"
export GPU_MEMORY_GB=16
export CUDA_VISIBLE_DEVICES=0
export TENSOR_PARALLEL_SIZE=1

# --- Model ---
# With 16GB, use the official FP8 checkpoint to preserve KV cache headroom.
export MODEL_ID="Qwen/Qwen3-8B-FP8"
export MODEL_QUANTIZATION="fp8"          # fp8 | awq | gptq | none
export VLLM_QUANTIZATION_ARGS=""
export VLLM_EXTRA_ARGS="--enable-auto-tool-choice --tool-call-parser qwen3_xml"
export MAX_MODEL_LEN=4096                 # Safer default for 16GB with desktop display overhead
export GPU_MEMORY_UTILIZATION=0.82

# --- Serving ---
export SERVED_PORT=8000
export MAX_NUM_SEQS=16
export MAX_INPUT_TOKENS=3584

# --- Images ---
export VLLM_IMAGE="vllm/vllm-openai:v0.21.0-cu129-ubuntu2404"
export SGLANG_IMAGE="lmsysorg/sglang:nightly-dev-cu13-20260522-c9153da5"
export TGI_IMAGE="ghcr.io/huggingface/text-generation-inference:3.3.4"
export TGI_EXTRA_ARGS=""
export TENSORRT_LLM_IMAGE="nvcr.io/nvidia/tensorrt-llm/release:1.2.0rc7"
export RAY_IMAGE="rayproject/ray:2.55.1-py312-gpu"
export PROMETHEUS_IMAGE="prom/prometheus:v3.11.0"
export DCGM_EXPORTER_IMAGE="nvidia/dcgm-exporter:4.4.1-4.6.0-distroless"
export GRAFANA_IMAGE="grafana/grafana:12.3.6-security-04-ubuntu"
export GRAFANA_ADMIN_PASSWORD="admin"
export RAY_BACKEND_URL="http://vllm:8000"

# --- Optional OpenLIT / OpenTelemetry ---
export OPENLIT_ENABLED=false
export OPENLIT_PORT=3001
export OPENLIT_OTLP_ENDPOINT="http://127.0.0.1:4318"
export OPENLIT_APPLICATION_NAME="llm-serving-lab"
export OPENLIT_CAPTURE_MESSAGE_CONTENT=false
export VLLM_OTEL_ARGS=""  # Enable with: --otlp-traces-endpoint grpc://host.docker.internal:4317
export VLLM_OTEL_SERVICE_NAME="vllm-server"
export VLLM_OTEL_PROTOCOL="grpc"
export VLLM_OTEL_INSECURE=true

# --- Benchmark ---
export BENCH_CONCURRENCY="1 4 8 16"
export BENCH_INPUT_TOKENS=512
export BENCH_OUTPUT_TOKENS=256
export BENCH_NUM_PROMPTS=200

# --- Notes ---
# Blackwell (sm_120) requires CUDA 12.8+ and recent container tags.
# If vLLM reports free GPU memory below desired utilization, close other GPU
# processes or lower GPU_MEMORY_UTILIZATION before increasing MAX_MODEL_LEN.
# 70B-class models are not viable with this profile -> use the datacenter profile.
